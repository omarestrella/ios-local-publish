#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CACHE="${IOS_PUBLISH_BUILD_CACHE:-$HOME/Library/Caches/ios-local-publish/swift-build}"
# Build products stay outside installed skills. SwiftPM serializes concurrent builds.
swift build --package-path "$ROOT/Publisher" --scratch-path "$CACHE" -c release >&2
BIN=$(swift build --package-path "$ROOT/Publisher" --scratch-path "$CACHE" -c release --show-bin-path)
exec "$BIN/ios-publish" "$@"
